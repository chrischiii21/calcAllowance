---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { getSession } from '../lib/auth';
import { parse } from 'cookie';
import { getAppSettings } from '../lib/settings';
import { getManualEntries } from '../lib/entries';
import { getClockifyUser, getRenderedHours, getStudentProgress } from '../lib/clockify';
import { formatHours } from '../lib/utils';
import { groupEntries } from '../lib/grouping';
import { periodEarnings, totalEarnings as sumEarnings } from '../lib/earnings';
import { getPayoutAdjustments } from '../lib/payouts';

const cookieHeader = Astro.request.headers.get('cookie') || '';
const cookies = parse(cookieHeader);
const user = cookies.session ? await getSession(cookies.session) : null;

if (!user) {
  return Astro.redirect('/');
}

const settings = await getAppSettings(user.id);

if (settings.role === 'coordinator') {
  return Astro.redirect('/coordinator');
}
if (settings.setupComplete === false) {
  return Astro.redirect('/dashboard');
}

const activeStartDate = settings.isEmployee ? (settings.employeeStartDate || settings.startDate) : settings.startDate;
const activePaySchedule = settings.isEmployee ? (settings.employeePaySchedule || 'monthly') : settings.paySchedule;

const renderedHours = await getStudentProgress(user.id, user.email, activeStartDate, settings.isEmployee);

let allRawEntries: { date: string, durationSeconds: number }[] = [];
try {
  if (settings.clockifyEnabled !== false) {
    const clockifyUser = await getClockifyUser(user.email);
    if (clockifyUser) {
      const clockifyData = await getRenderedHours(clockifyUser.id, activeStartDate);
      allRawEntries = [...clockifyData.entries];
    }
  }
} catch (e) {}

const manualEntries = await getManualEntries(user.id, settings.isEmployee);
allRawEntries = [
  ...allRawEntries,
  ...manualEntries
    .filter(e => new Date(e.date) >= new Date(activeStartDate))
    .map(e => ({ date: e.date, durationSeconds: e.durationSeconds }))
];

const grouped = groupEntries(allRawEntries, (settings.hasAllowance || settings.isEmployee) ? activePaySchedule : 'monthly');
const adjustments = await getPayoutAdjustments(user.id);

let runningCarryOver = 0;
const monthlyDataRaw = grouped.map(item => {
  const calculatedEarnings = periodEarnings(settings, item);
  const totalExpected = calculatedEarnings + runningCarryOver;

  const isSet = adjustments[item.label] !== undefined;
  const actualReceived = isSet ? adjustments[item.label] : totalExpected;
  const carryOver = totalExpected - actualReceived;

  const entry = {
    label: item.label,
    rendered: item.totalSeconds / 3600,
    daysWorked: item.daysWorked,
    calculated: calculatedEarnings,
    totalExpected,
    actualReceived,
    carryOverIn: runningCarryOver,
    carryOverOut: carryOver,
    isAdjusted: isSet
  };

  runningCarryOver = carryOver;
  return entry;
});

const monthlyData = [...monthlyDataRaw].reverse();

// Sum the same per-period figures shown in the list, so the header total can't drift from the rows.
const totalEarnings = sumEarnings(settings, grouped);

const isEarningsMode = settings.hasAllowance || settings.isEmployee;
---

<Layout title="Earnings">
  <Header user={user} />

  <div id="portal-body">
    <Sidebar user={user} activeTab="earnings" role={settings.role} />

    <main id="portal-main">
      <div class="bg-grid" aria-hidden="true"></div>

      <div id="earnings-content" class="content-center">
        <div class="page-header">
          <div>
            <h1>{isEarningsMode ? 'Earnings' : 'Hours'} <span class="accent">Breakdown</span></h1>
            <p>{isEarningsMode ? 'Track your expected pay and payout status per period.' : 'Your logged hours grouped by month.'}</p>
          </div>
        </div>

        <div class="full-grid">
          <section class="earnings-breakdown">
            <div class="section-header">
              <h2>{isEarningsMode ? 'Period' : 'Monthly'} <span class="accent">Summary</span></h2>
              <div class="total-earnings-summary">
                <span class="summary-label">{isEarningsMode ? 'Total Expected:' : 'Total Rendered:'}</span>
                <span class="summary-value">
                  {isEarningsMode
                    ? `₱ ${totalEarnings.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
                    : `${formatHours(renderedHours)}`}
                </span>
              </div>
            </div>
            <div class="breakdown-list">
              {monthlyData.map(item => (
  <div class="breakdown-item-wrapper">
    <div class="breakdown-item">
      <div class="item-main">
        <span class="item-label">{item.label}</span>
        <div class="item-meta">
          {isEarningsMode ? (
            <>
              <span class="item-hours">
                {!settings.isEmployee && settings.payType === 'daily'
                  ? `${item.daysWorked} ${item.daysWorked === 1 ? 'day' : 'days'} worked · ${formatHours(item.rendered)}`
                  : `${formatHours(item.rendered)} tracked`}
              </span>
              {item.carryOverIn !== 0 && (
                <span class={`carry-tag ${item.carryOverIn > 0 ? 'plus' : 'minus'}`}>
                  {item.carryOverIn > 0 ? '+' : ''}₱{item.carryOverIn.toLocaleString()} carry-over
                </span>
              )}
            </>
          ) : (
            <span class="item-hours">Internship Hours Logged</span>
          )}
        </div>
      </div>
      {isEarningsMode ? (
        <div class="item-values">
          {item.isAdjusted ? (
            <div class="payout-status set">
              <div class="value-group">
                <span class="v-label">Received</span>
                <span class="v-amount received">₱ {item.actualReceived.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
              </div>
              <button class="btn-edit-payout" data-label={item.label} data-amount={item.actualReceived.toFixed(2)}>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4L18.5 2.5z"></path></svg>
              </button>
            </div>
          ) : (
            <div class="payout-status pending">
               <div class="value-group">
                <span class="v-label">Expected</span>
                <span class="v-amount">₱ {item.totalExpected.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
              </div>
              <div class="status-actions">
                <form action="/api/payouts" method="POST" class="inline-form">
                  <input type="hidden" name="periodLabel" value={item.label} />
                  <input type="hidden" name="amountReceived" value={item.totalExpected.toFixed(2)} />
                  <input type="hidden" name="redirect" value="/earnings" />
                  <button type="submit" class="btn-received">Received</button>
                </form>
                <button class="btn-edit-payout secondary" data-label={item.label} data-amount={item.totalExpected.toFixed(2)}>Edit</button>
              </div>
            </div>
          )}

          <form action="/api/payouts" method="POST" class="payout-edit-form" style="display: none;">
            <input type="hidden" name="periodLabel" value={item.label} />
            <input type="hidden" name="redirect" value="/earnings" />
            <div class="compact-input-group">
              <span class="v-currency">₱</span>
              <input
                type="number"
                name="amountReceived"
                value={item.actualReceived.toFixed(2)}
                step="0.01"
                class="v-amount-input"
              />
              <button type="submit" class="btn-save-inline">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </button>
            </div>
          </form>
        </div>
      ) : (
        <div class="item-values">
          <div class="value-group">
            <span class="v-label">Rendered</span>
            <span class="v-amount">{formatHours(item.rendered)}</span>
          </div>
        </div>
      )}
    </div>
    {isEarningsMode && item.carryOverOut !== 0 && (
      <div class="carry-over-line">
        <span class="line-text">
          {item.carryOverOut > 0 ? 'Excess' : 'Shortage'} of ₱{Math.abs(item.carryOverOut).toLocaleString()} added to next period
        </span>
      </div>
    )}
  </div>
))}
              {monthlyData.length === 0 && (
                <div class="empty-breakdown">No logs recorded for the current program period.</div>
              )}
            </div>
          </section>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  const params = new URLSearchParams(window.location.search);

  const successVal = params.get('success');
  if (successVal) {
    const msg = successVal === 'true' ? 'Updated' : successVal;
    window.showToast(msg, 'success');
    window.history.replaceState({}, '', window.location.pathname);
  }
  if (params.get('error')) {
    window.showToast(decodeURIComponent(params.get('error')), 'error');
    window.history.replaceState({}, '', window.location.pathname);
  }

  // Payout Edit Toggle
  document.querySelectorAll('.btn-edit-payout').forEach(btn => {
    btn.addEventListener('click', () => {
      const wrapper = btn.closest('.item-values');
      const statusDiv = wrapper.querySelector('.payout-status');
      const editForm = wrapper.querySelector('.payout-edit-form');

      if (statusDiv && editForm) {
        statusDiv.style.display = 'none';
        editForm.style.display = 'flex';
        const input = editForm.querySelector('input[type="number"]');
        input.focus();
        input.select();
      }
    });
  });

  // Handle visual loading state on form submissions
  document.addEventListener('submit', (e) => {
    const form = e.target;
    if (form.dataset.submitting === 'true') return;

    const btn = e.submitter || form.querySelector('button[type="submit"]');
    if (!btn) return;

    btn.disabled = true;
    btn.style.opacity = '0.7';

    let loadingText = 'Loading...';
    if (btn.classList.contains('btn-received')) {
      loadingText = 'UPDATING...';
    } else if (btn.classList.contains('btn-save-inline')) {
      loadingText = 'SAVING...';
    }

    btn.innerHTML = `
      <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" style="display:inline-block; vertical-align:middle; width:16px; height:16px; animation: spin 1s linear infinite; margin-right: 8px;">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" style="opacity: 0.25;"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" style="opacity: 0.75;"></path>
      </svg>
      ${loadingText}
    `;
    form.dataset.submitting = 'true';
  });
</script>

<style>
  #portal-body { display: flex; min-height: 100vh; padding-top: 56px; }
  #portal-main { margin-left: 220px; flex: 1; padding: 40px; position: relative; }
  .bg-grid { position: fixed; inset: 0; background-image: linear-gradient(rgba(237, 102, 33, .04) 1px, transparent 1px), linear-gradient(90deg, rgba(237, 102, 33, .04) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; }

  #earnings-content { position: relative; z-index: 1; max-width: 1000px; animation: cin .5s cubic-bezier(.16,1,.3,1) both; }
  @keyframes cin { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
  @keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }

  .page-header { margin-bottom: 32px; }
  .page-header h1 { font-size: 28px; font-weight: 700; color: #fff; letter-spacing: -0.02em; }
  .accent { background: var(--ntv-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .page-header p { color: var(--text-secondary); font-size: 14px; margin-top: 4px; }

  .full-grid { width: 100%; }

  .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .section-header h2 { font-size: 18px; font-weight: 600; color: #fff; }

  .total-earnings-summary { text-align: right; }
  .summary-label { display: block; font-size: 10px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; }
  .summary-value { font-size: 18px; font-weight: 700; color: var(--text-primary); }

  .earnings-breakdown { background: var(--card-bg); border: 1px solid var(--border-subtle); border-radius: 24px; padding: 24px; }
  .breakdown-list { display: flex; flex-direction: column; gap: 16px; margin-top: 16px; }
  .breakdown-item-wrapper { display: flex; flex-direction: column; gap: 8px; }
  .breakdown-item { display: flex; justify-content: space-between; align-items: center; padding: 18px 24px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 18px; transition: 0.2s; }
  .breakdown-item:hover { background: rgba(255,255,255,0.05); border-color: rgba(237, 102, 33, 0.2); }

  .item-meta { display: flex; align-items: center; gap: 12px; }
  .item-label { display: block; font-size: 15px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px; }
  .item-hours { font-size: 12px; color: var(--text-secondary); }

  .carry-tag { font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 6px; text-transform: uppercase; }
  .carry-tag.plus { background: rgba(52, 211, 153, 0.1); color: #34d399; }
  .carry-tag.minus { background: rgba(248, 113, 113, 0.1); color: #f87171; }

  .item-values { display: flex; align-items: center; gap: 20px; }

  .payout-status { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .payout-status.set { border-right: 2px solid #34d399; padding-right: 16px; align-items: flex-end; }

  .status-actions { display: flex; align-items: center; gap: 6px; }
  .inline-form { display: flex; }

  .btn-received {
    background: rgba(52, 211, 153, 0.1); border: 1px solid rgba(52, 211, 153, 0.2);
    color: #34d399; padding: 6px 14px; border-radius: 8px; font-size: 10px; font-weight: 800;
    cursor: pointer; text-transform: uppercase; transition: all 0.2s; letter-spacing: 0.02em;
    font-family: inherit;
  }
  .btn-received:hover { background: #34d399; color: #fff; border-color: #34d399; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(52, 211, 153, 0.2); }

  .btn-edit-payout {
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
    color: var(--text-secondary); padding: 6px 12px; border-radius: 8px; font-size: 10px; font-weight: 700;
    cursor: pointer; transition: all 0.2s; text-transform: uppercase;
    font-family: inherit;
  }
  .btn-edit-payout:hover { background: rgba(255,255,255,0.12); color: #fff; border-color: rgba(255,255,255,0.2); }
  .btn-edit-payout.secondary { background: none; border: 1px solid rgba(255,255,255,0.08); }
  .btn-edit-payout.secondary:hover { background: rgba(255,255,255,0.05); }

  .payout-edit-form { display: flex; align-items: center; gap: 8px; }
  .compact-input-group { display: flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); padding: 4px 10px; border-radius: 10px; transition: 0.2s; }
  .compact-input-group:focus-within { background: rgba(237, 102, 33, 0.05); border-color: rgba(237, 102, 33, 0.4); box-shadow: 0 0 12px rgba(237, 102, 33, 0.1); }
  .v-currency { font-size: 14px; font-weight: 800; color: var(--ntv-orange); }
  .v-amount-input { background: none; border: none; color: var(--text-primary); font-size: 16px; font-weight: 800; width: 90px; text-align: right; outline: none; font-family: inherit; }
  .v-amount-input::-webkit-inner-spin-button { display: none; }

  .btn-save-inline { background: var(--ntv-gradient); border: none; color: #fff; width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; }
  .btn-save-inline:hover { transform: scale(1.1); filter: brightness(1.1); }

  .value-group { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
  .v-label { font-size: 9px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; }
  .v-amount { font-size: 16px; font-weight: 800; color: var(--text-primary); }
  .v-amount.received { color: #34d399; }

  .carry-over-line { padding-left: 24px; position: relative; }
  .carry-over-line::before { content: ''; position: absolute; left: 10px; top: -8px; bottom: 50%; width: 2px; border-left: 2px dashed rgba(255,255,255,0.1); border-bottom: 2px dashed rgba(255,255,255,0.1); border-bottom-left-radius: 8px; }
  .line-text { font-size: 11px; font-weight: 600; color: var(--text-secondary); opacity: 0.7; }

  .empty-breakdown { text-align: center; padding: 32px; color: var(--text-secondary); font-size: 13px; font-style: italic; background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px dashed rgba(255,255,255,0.1); }

  @media (max-width: 900px) {
    #portal-main { margin-left: 0; padding: 20px; }
  }
</style>

<script is:inline>
  // First-visit walkthrough for this page; replayable any time from the header's tour button.
  window.InternFlowTour?.register('earnings', [
    {
      target: '.page-header',
      title: 'Earnings',
      body: 'What your logged hours are worth, split into the pay periods your schedule defines — weekly, semi-monthly or monthly.',
    },
    {
      target: '.earnings-breakdown',
      title: 'Period by period',
      body: 'Each row shows the hours in that period and the amount they add up to, so you can check a payout against your own records.',
    },
    {
      target: '.btn-received',
      title: 'Mark a payout as received',
      body: "Confirm a period once you've actually been paid, so pending and settled amounts stay separate.",
    },
  ]);
  window.InternFlowTour?.autoStart();
</script>
