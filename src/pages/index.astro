---
import Layout from '../layouts/Layout.astro';
import { getSession } from '../lib/auth';
import { parse } from 'cookie';

// Check if user is logged in
const cookieHeader = Astro.request.headers.get('cookie') || '';
const cookies = parse(cookieHeader);
const user = cookies.session ? await getSession(cookies.session) : null;

// If logged in, redirect to dashboard
if (user) {
  return Astro.redirect('/dashboard');
}

const features = [
  {
    title: 'Live Time Tracking',
    desc: 'Clock in and out with one click. Hours sync automatically through the Clockify API, so nothing has to be logged twice.',
    icon: `<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>`,
  },
  {
    title: 'Auto-Generated DTR',
    desc: 'Your Daily Time Record fills itself in from tracked hours, with an Excel-like grid if you ever need to fine-tune an entry.',
    icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M9 13h6M9 17h6"/>`,
  },
  {
    title: 'Attendance & Progress',
    desc: 'See a calendar view of present, absent, WFH, sick and vacation days, plus a live countdown to your required hours.',
    icon: `<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m8.5 15 2 2 4-4"/>`,
  },
  {
    title: 'Coordinator Oversight',
    desc: 'Coordinators get a roster view of every student intern — hours completed, DTR status, and attendance at a glance.',
    icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
];

const faqs = [
  {
    q: 'How do I sign in?',
    a: 'InternFlow uses Google Sign-In only — there\'s no separate password to create or remember. Click "Continue with Google" and authorize with your existing Google account.',
  },
  {
    q: 'Do I need a special or school-issued account?',
    a: 'No. Any Google account works. Your coordinator may ask you to use a specific email so they can match your entries to your roster.',
  },
  {
    q: 'What data does InternFlow track?',
    a: 'Clock-in/clock-out timestamps, computed daily and total hours, attendance status per day, and the DTR entries you or the sync process generate. We don\'t track anything outside your work sessions.',
  },
  {
    q: 'Can my coordinator see my hours?',
    a: 'Yes, if your account is linked to a coordinator\'s roster, they can view your logged hours, DTR, and attendance so they can verify and endorse your progress.',
  },
  {
    q: 'Is my data secure?',
    a: 'Sign-in goes through Google OAuth, and sessions are stored server-side rather than as data sitting in your browser. You can request account and data deletion at any time from Settings.',
  },
  {
    q: 'What if I forget to clock in or out?',
    a: 'You can edit any entry directly in the DTR grid afterward, so a missed clock-in or clock-out doesn\'t break your record for the day.',
  },
];

const pageDescription = 'InternFlow tracks internship hours, auto-builds your DTR, and charts attendance — sign in with Google, no separate password needed.';

// Structured data so search/AI crawlers can answer questions about the product and its FAQ directly.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'InternFlow',
      description: pageDescription,
      url: new URL('/', Astro.site).toString(),
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Any (Web)',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
  ],
};
---
<Layout title="Internship Hours & Progress Tracker" description={pageDescription}>
  <header id="lp-header">
    <div class="lp-logo">
      <img src="/logo.png" alt="Logo" width="30" height="30" />
      <span class="lp-logo-primary">InternFlow</span>
    </div>
    <nav class="lp-nav">
      <a href="#overview">Overview</a>
      <a href="#faq">FAQ</a>
    </nav>
    <div class="lp-header-right">
      <button type="button" id="theme-toggle" class="theme-toggle-btn" title="Toggle Theme">
        <svg id="theme-sun-icon" class="theme-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg id="theme-moon-icon" class="theme-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <a href="/api/auth/google" class="lp-nav-cta">Log in</a>
    </div>
  </header>

  <main id="lp-main">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-glow" aria-hidden="true"></div>

    <!-- HERO -->
    <section class="lp-hero">
      <div class="card-eyebrow"><span class="eyebrow-dot"></span><span>Internship Hours & Progress Tracker</span></div>
      <h1 class="lp-title">Track your internship,<br/><span class="card-accent">without the spreadsheet.</span></h1>
      <p class="lp-sub">InternFlow logs your hours, builds your DTR, and charts your attendance automatically — so you and your coordinator always know exactly where you stand.</p>
      <div class="lp-cta-row">
        <a href="/api/auth/google" id="google-btn">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20" height="20"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.35-8.16 2.35-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
          <span>Continue with Google</span>
        </a>
        <a href="#overview" class="lp-secondary-btn">See how it works</a>
      </div>
      <div class="sec-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M12 2L3 7V12C3 16.55 6.84 20.74 12 22C17.16 20.74 21 16.55 21 12V7L12 2Z" stroke="var(--ntv-orange)" stroke-opacity="0.8" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 12L11 14L15 10" stroke="var(--ntv-orange)" stroke-opacity="0.8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Sign in with Google — no separate password needed</span>
      </div>
    </section>

    <!-- OVERVIEW -->
    <section id="overview" class="lp-section">
      <h2 class="lp-section-title">Everything your DTR needs, in one place</h2>
      <p class="lp-section-sub">A quick look at what you get once you're signed in.</p>
      <div class="lp-feature-grid">
        {features.map((f) => (
          <div class="lp-feature-card">
            <div class="feature-icon" set:html={`<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${f.icon}</svg>`} />
            <div class="step-details">
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="lp-section">
      <h2 class="lp-section-title">Frequently asked questions</h2>
      <p class="lp-section-sub">Still unsure? Here's what most interns ask before signing in.</p>
      <div class="lp-faq-list">
        {faqs.map((item) => (
          <details class="lp-faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="lp-final-cta-wrap">
      <div class="lp-final-cta">
        <h2>Ready to start tracking?</h2>
        <p>Sign in with your Google account to set up your profile and clock your first session.</p>
        <a href="/api/auth/google" id="google-btn" class="lp-final-google-btn">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20" height="20"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.35-8.16 2.35-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
          <span>Continue with Google</span>
        </a>
      </div>
    </section>

    <footer class="lp-footer">
      <span>InternFlow — Internship Hours & Progress Tracker</span>
    </footer>
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const successVal = params.get('success');
  if (successVal) {
    const msg = successVal === 'true' ? 'Welcome!' : successVal;
    window.showToast(msg, 'success');
    window.history.replaceState({}, '', window.location.pathname);
  }
  if (params.get('error')) {
    window.showToast(decodeURIComponent(params.get('error')), 'error');
    window.history.replaceState({}, '', window.location.pathname);
  }

  // Theme toggle — same localStorage contract as the in-app Header component.
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-sun-icon');
  const moonIcon = document.getElementById('theme-moon-icon');

  function updateThemeIcons() {
    const isLight = document.documentElement.classList.contains('light-mode');
    if (sunIcon) sunIcon.style.display = isLight ? 'block' : 'none';
    if (moonIcon) moonIcon.style.display = isLight ? 'none' : 'block';
  }
  updateThemeIcons();

  themeToggle?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light-mode');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
    updateThemeIcons();
  });
</script>

<style>
  * { box-sizing: border-box; }

  /* HEADER */
  #lp-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 24px; height: 60px;
    background: color-mix(in srgb, var(--ntv-bg) 88%, transparent);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
  }
  .lp-logo { display: flex; align-items: center; gap: 8px; }
  .lp-logo-primary { color: var(--ntv-orange); font-weight: 700; font-size: 14px; letter-spacing: .08em; }
  .lp-nav { display: flex; gap: 28px; }
  .lp-nav a { color: var(--text-secondary); text-decoration: none; font-size: 13px; font-weight: 600; transition: color .2s; }
  .lp-nav a:hover { color: var(--ntv-orange); }
  .lp-header-right { display: flex; align-items: center; gap: 10px; }
  .theme-toggle-btn {
    display: flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 9px;
    background: rgba(127,127,127,.08); border: 1px solid var(--border-subtle);
    color: var(--text-primary); cursor: pointer; transition: all .2s;
  }
  .theme-toggle-btn:hover { background: rgba(127,127,127,.15); transform: scale(1.05); }
  .lp-nav-cta {
    padding: 9px 20px; border-radius: 9px; background: var(--ntv-gradient);
    color: #fff; text-decoration: none; font-size: 13px; font-weight: 700;
    box-shadow: 0 4px 14px rgba(237,102,33,.25); transition: all .2s;
  }
  .lp-nav-cta:hover { filter: brightness(1.08); transform: translateY(-1px); }

  /* MAIN */
  #lp-main { position: relative; min-height: 100vh; padding-top: 60px; overflow: hidden; }
  .bg-grid { position: fixed; inset: 0; background-image: linear-gradient(rgba(237,102,33,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(237,102,33,.03) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; }
  .bg-glow { position: fixed; top: 8%; left: 55%; transform: translateX(-50%); width: 620px; height: 400px; background: radial-gradient(ellipse, rgba(237,102,33,.1) 0%, transparent 70%); pointer-events: none; }

  /* HERO */
  .lp-hero {
    position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center;
    text-align: center; gap: 18px; max-width: 640px; margin: 0 auto; padding: 96px 24px 72px;
  }
  .card-eyebrow { display: flex; align-items: center; gap: 7px; font-size: 10.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ntv-orange); opacity: 0.85; }
  .eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ntv-orange); box-shadow: 0 0 6px var(--ntv-orange); }
  .lp-title { font-size: 44px; font-weight: 700; line-height: 1.2; letter-spacing: -.01em; color: var(--text-primary); font-family: 'Outfit', sans-serif; }
  .card-accent { background: var(--ntv-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .lp-sub { font-size: 15.5px; color: var(--text-secondary); line-height: 1.65; max-width: 520px; }

  .lp-cta-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
  #google-btn {
    display: flex; align-items: center; justify-content: center; gap: 12px;
    padding: 13px 24px; background: #fff; color: #050b16;
    border: 1px solid var(--border-subtle); border-radius: 11px; font-size: 14px; font-weight: 700; cursor: pointer; transition: all .2s;
    box-shadow: 0 4px 20px rgba(0,0,0,.18); text-decoration: none; font-family: 'Outfit', sans-serif;
  }
  #google-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 28px rgba(0,0,0,.22); }
  .lp-secondary-btn {
    padding: 13px 24px; border-radius: 11px; border: 1px solid var(--border-subtle);
    color: var(--text-primary); text-decoration: none; font-size: 14px; font-weight: 700;
    font-family: 'Outfit', sans-serif; transition: all .2s;
  }
  .lp-secondary-btn:hover { border-color: rgba(237,102,33,.4); color: var(--ntv-orange); background: rgba(237,102,33,.05); }

  .sec-badge {
    display: flex; align-items: center; gap: 8px; padding: 10px 16px; margin-top: 10px;
    background: rgba(237,102,33,.06); border: 1px solid rgba(237,102,33,.15);
    border-radius: 20px; font-size: 12px; color: var(--text-secondary);
  }

  /* SECTIONS */
  .lp-section { position: relative; z-index: 1; max-width: 920px; margin: 0 auto; padding: 60px 24px; scroll-margin-top: 76px; }
  .lp-section-title { font-size: 28px; font-weight: 700; color: var(--text-primary); text-align: center; font-family: 'Outfit', sans-serif; letter-spacing: -.01em; }
  .lp-section-sub { font-size: 14px; color: var(--text-secondary); text-align: center; margin-top: 8px; margin-bottom: 40px; }

  .lp-feature-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .lp-feature-card {
    display: flex; gap: 16px; align-items: flex-start; padding: 24px;
    background: var(--card-bg); border: 1px solid var(--border-subtle); border-radius: 16px;
    transition: transform .2s, border-color .2s, box-shadow .2s;
  }
  .lp-feature-card:hover {
    transform: translateY(-3px); border-color: rgba(237,102,33,.3);
    box-shadow: 0 12px 32px rgba(0,0,0,.12);
  }
  .feature-icon {
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    width: 42px; height: 42px; border-radius: 12px;
    background: rgba(237,102,33,.1); border: 1px solid rgba(237,102,33,.2);
    color: var(--ntv-orange);
  }
  .step-details h3 { font-size: 15.5px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
  .step-details p { font-size: 13px; color: var(--text-secondary); line-height: 1.6; }

  /* FAQ */
  .lp-faq-list { display: flex; flex-direction: column; gap: 10px; }
  .lp-faq-item {
    background: var(--card-bg); border: 1px solid var(--border-subtle); border-radius: 12px;
    padding: 18px 22px; transition: border-color .2s;
  }
  .lp-faq-item:hover { border-color: rgba(237,102,33,.25); }
  .lp-faq-item summary {
    cursor: pointer; font-size: 14.5px; font-weight: 600; color: var(--text-primary); list-style: none;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .lp-faq-item summary::-webkit-details-marker { display: none; }
  .lp-faq-item summary::after { content: '+'; color: var(--ntv-orange); font-size: 19px; font-weight: 400; flex-shrink: 0; }
  .lp-faq-item[open] summary::after { content: '−'; }
  .lp-faq-item p { font-size: 13.5px; color: var(--text-secondary); line-height: 1.65; margin-top: 14px; }

  /* FINAL CTA */
  .lp-final-cta-wrap { position: relative; z-index: 1; padding: 20px 24px 88px; }
  .lp-final-cta {
    text-align: center; max-width: 560px; margin: 0 auto;
    padding: 48px 32px; border-radius: 20px;
    background: linear-gradient(180deg, rgba(237,102,33,.08) 0%, rgba(237,102,33,.02) 100%);
    border: 1px solid rgba(237,102,33,.18);
    display: flex; flex-direction: column; align-items: center; gap: 14px;
  }
  .lp-final-cta h2 { font-size: 25px; font-weight: 700; color: var(--text-primary); font-family: 'Outfit', sans-serif; }
  .lp-final-cta p { font-size: 14px; color: var(--text-secondary); }
  .lp-final-google-btn { margin-top: 8px; }

  .lp-footer {
    position: relative; z-index: 1; text-align: center; padding: 24px;
    border-top: 1px solid var(--border-subtle); font-size: 12px; color: var(--text-secondary);
  }

  @media (max-width: 700px) {
    .lp-nav { display: none; }
    .lp-title { font-size: 32px; }
    .lp-feature-grid { grid-template-columns: 1fr; }
    .lp-final-cta { padding: 36px 22px; }
  }
</style>
